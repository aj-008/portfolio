---
import Layout from '../layouts/Layout.astro';

const skills = [
  'Rust', 'C++', 'Python', 'TypeScript/React',
  'ChampSim', 'Computer Architecture', 'Docker', 'Linux',
  'Embedded Systems (STM32)', 'CUDA', 'Tailscale/self-hosting', 'Git',
];
---
<Layout title="About">
  <section class="py-8 max-w-2xl">
    <h1 class="font-mono text-2xl text-slate-100 mb-6">About Me</h1>

    <div class="prose prose-invert max-w-none">
      <p>
      I'm a Computer Engineering student at Tufts focused on computer architecture and design. Anything close to the metal excites me, whether it's computer architecture, systems programming, embedded systems, or anywhere the hardware and software have to agree on something. I like learning by digging deep into real systems and pulling things together as I go. I learn fast, work well solo, and love to collaborate when the problem calls for it.
      </p>
      <p>
      Most of my recent work centers on cache replacement policy research, from
        co-authoring a research project evaluating how modern LLC policies generalize
        across workloads, to building <a href="/projects/aster">Aster</a>, a
        Rust cache simulator, to look deeper into the memory system.
      </p>
      <p>
        I self-host a media server for myself and my friends,
        I'm big into ricing my laptop & dev environment,
        and outside of tech, I enjoy cooking, baking, and fitness.
      </p>
    </div>

    <h2 class="font-mono uppercase tracking-wide text-muted mt-10 mb-4">Like this theme?</h2>
    <div class="prose prose-invert max-w-none">
        <p>
        This site's color palette is generated from whatever wallpaper I am currently using on my laptop. I use a small script to pull colors from <a href="https://github.com/dylanaraps/pywal">pywal</a> and theme my whole desktop — terminal, editor, file browser, status bar, lockscreen, all of it. You can check out my setup in its entirety below.
        </p>
      <p>
        <a href="https://github.com/aj-008/dotfiles" target="_blank" rel="noopener noreferrer">Full dotfiles →</a>
      </p>
    </div>

    <h2 class="font-mono uppercase tracking-wide text-muted mt-10 mb-4">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="text-xs font-mono rounded bg-white/5 px-2 py-1 text-slate-300">{skill}</span>
      ))}
    </div>
  </section>
</Layout>
