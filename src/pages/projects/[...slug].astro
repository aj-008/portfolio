---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, tagline, stack, role, demoUrl, githubUrl, writeupUrl } = project.data;
---
<Layout title={title} description={tagline}>
  <article class="py-12 max-w-2xl">
    <a href="/projects" class="text-sm text-muted hover:text-slate-100">← all projects</a>

    <div class="mt-6">
      <h1 class="font-display text-3xl text-slate-100">{title}</h1>
      <p class="mt-2 text-muted">{tagline}</p>
      {role && <p class="text-sm text-muted mt-1">{role}</p>}
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {stack.map((tech: string) => (
        <span class="text-xs font-mono rounded bg-white/5 px-2 py-1 text-slate-300">{tech}</span>
      ))}
    </div>

    {(demoUrl || githubUrl || writeupUrl) && (
      <div class="mt-6 pt-6 border-t border-white/10 flex flex-wrap gap-3 text-sm">
        {demoUrl && (
          <a href={demoUrl} target="_blank" rel="noopener noreferrer"
             class="rounded bg-accent text-bg font-medium px-4 py-2 hover:opacity-90">
            Live Page →
          </a>
        )}
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer"
             class="rounded border border-white/20 px-4 py-2 hover:border-white/40">
            Source →
          </a>
        )}
        {writeupUrl && (
          <a href={writeupUrl} target="_blank" rel="noopener noreferrer"
             class="rounded border border-white/20 px-4 py-2 hover:border-white/40">
            Full write-up →
          </a>
        )}
      </div>
    )}

    <div class="prose prose-invert prose-sm mt-10 max-w-none">
      <Content />
    </div>
  </article>
</Layout>
