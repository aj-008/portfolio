---
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  /** Max thumbnail width in px. 520 is a good default; bump to 640 for
   *  screenshots with dense UI text, drop to 400 for simple diagrams. */
  size?: number;
}

const { images, size = 520 } = Astro.props;
---

<div class="not-prose my-8 -mx-1">
  <div class="flex gap-4 overflow-x-auto pb-3 px-1 snap-x snap-mandatory scrollbar-thin">
    {images.map((img) => (
      <figure class="shrink-0 snap-start" style={`width: min(88vw, ${size}px)`}>
        <button
          type="button"
          data-zoom
          data-src={img.src}
          data-alt={img.alt}
          aria-label={`Expand image: ${img.alt}`}
          class="group relative block w-full rounded-md border border-white/10 bg-surface overflow-hidden cursor-zoom-in transition-colors hover:border-white/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
        >
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto block"
            loading="lazy"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute bottom-2 right-2 rounded border border-white/15 bg-black/60 px-1.5 py-0.5 text-[10px] font-mono text-white/70 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
          >
            expand
          </span>
        </button>
        {(img.caption || img.alt) && (
          <figcaption class="mt-2 text-xs font-sans text-muted">
            {img.caption || img.alt}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
</div>

<style>
  .scrollbar-thin {
    scrollbar-width: thin;
  }
  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: theme('colors.white / 15%');
    border-radius: 3px;
  }
</style>

<style is:global>
  #gallery-lightbox {
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    background: transparent;
    overflow: visible;
  }
  #gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }
  #gallery-lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 96vw;
    max-height: 94vh;
    border-radius: 6px;
  }
  #gallery-lightbox .lightbox-close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    background: #000;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  #gallery-lightbox .lightbox-close:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
</style>

<script>
  function ensureLightbox(): HTMLDialogElement {
    const existing = document.getElementById('gallery-lightbox');
    if (existing) return existing as HTMLDialogElement;

    const dialog = document.createElement('dialog');
    dialog.id = 'gallery-lightbox';
    dialog.innerHTML =
      '<button class="lightbox-close" aria-label="Close image">\u00d7</button><img alt="" />';
    document.body.appendChild(dialog);

    // Click the backdrop or the close button to dismiss.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest('.lightbox-close')) {
        dialog.close();
      }
    });

    return dialog;
  }

  function initGallery() {
    document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
      if (button.dataset.zoomBound) return;
      button.dataset.zoomBound = 'true';

      button.addEventListener('click', () => {
        const dialog = ensureLightbox();
        const img = dialog.querySelector('img');
        if (!img) return;
        img.src = button.dataset.src ?? '';
        img.alt = button.dataset.alt ?? '';
        dialog.showModal();
      });
    });
  }

  initGallery();
  // Re-bind if you ever enable Astro view transitions.
  document.addEventListener('astro:page-load', initGallery);
</script>
