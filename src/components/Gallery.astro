---
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---
<div class="not-prose my-8 -mx-1">
  <div class="flex gap-4 overflow-x-auto pb-3 px-1 snap-x snap-mandatory scrollbar-thin">
    {images.map((img) => (
      <figure class="shrink-0 snap-start w-[min(80vw,340px)]">
        <div class="rounded-md border border-white/10 bg-surface overflow-hidden">
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto block"
            loading="lazy"
          />
        </div>
        {(img.caption || img.alt) && (
          <figcaption class="mt-2 text-xs font-mono text-muted">
            {img.caption || img.alt}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
</div>

<style>
  .scrollbar-thin {
    scrollbar-width: thin;
  }
  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: theme('colors.white / 15%');
    border-radius: 3px;
  }
</style>
