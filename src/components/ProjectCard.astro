---
interface Props {
  title: string;
  tagline: string;
  stack: string[];
  role?: string;
  href: string;
  demoUrl?: string;
  githubUrl?: string;
}
const { title, tagline, stack, role, href, demoUrl, githubUrl } = Astro.props;
---
<a href={href} class="group block rounded-lg border border-white/10 bg-surface p-5 transition hover:border-accent/50">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-sans text-lg text-slate-100 group-hover:text-accent">{title}</h3>
    {role && <span class="text-xs text-muted whitespace-nowrap">{role}</span>}
  </div>
  <p class="mt-1 text-sm text-muted">{tagline}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {stack.map((tech) => (
      <span class="text-xs font-mono rounded bg-white/5 px-2 py-1 text-slate-300">{tech}</span>
    ))}
  </div>
  <div class="mt-3 flex gap-4 text-xs">
    {demoUrl && <span class="text-accent">Live page →</span>}
    {githubUrl && <span class="text-muted">Source →</span>}
  </div>
</a>
